# Copie este arquivo para ".env" (sem o ".example") e preencha.
# O arquivo .env NUNCA deve ser publicado nem compartilhado.

# ---- OBRIGATÓRIO ----
# Chave gratuita da Groq: https://console.groq.com/keys  (começa com "gsk_")
GROQ_API_KEY=cole_sua_chave_aqui

# ---- OPCIONAL ----
# Senha para abrir a página de Administração (deixe vazio para não pedir senha)
ADMIN_PASSWORD=

# Modelos de embedding baixados pelo Ollama, separados por espaço.
# Padrão: nomic-embed-text bge-m3
# MODELOS_OLLAMA=nomic-embed-text bge-m3

# Whisper (transcrição de áudio). Normalmente não precisa mexer.
# WHISPER_DEVICE=auto          # auto, cpu ou cuda
# WHISPER_COMPUTE_TYPE=        # vazio = automático (int8 na CPU)
